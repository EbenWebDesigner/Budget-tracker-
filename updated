<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="Budget">
<meta name="mobile-web-app-capable" content="yes">
<title>Monthly Budget Tracker</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600;700&display=swap');

  :root {
    --bg: #F4F3F8;
    --card: #FFFFFF;
    --border: #D8D6E3;
    --track: #E9E7F0;
    --ink: #2E2A38;
    --ink-dim: #6D6E71;
    --muted: #8B8994;
    --faint: #ADABB6;
    --dark: #3A3550;
    --dark-bad: #4A2038;
    --good: #6D4AFF;
    --bad: #C24E7A;
    --bad-text: #8A2B57;
    --bad-bg: #FBEAF2;
    --bad-border: #E8A9C6;
    --accent: #6D4AFF;
  }

  * { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
  html, body { margin: 0; padding: 0; }
  body {
    font-family: 'Fraunces', Georgia, serif;
    background: var(--bg);
    color: var(--ink);
    padding: 24px 16px 60px;
    -webkit-font-smoothing: antialiased;
  }
  .sans { font-family: 'Inter', system-ui, sans-serif; }
  ::-webkit-scrollbar { width: 8px; height: 8px; }
  ::-webkit-scrollbar-thumb { background: #D0CCE0; border-radius: 4px; }

  input, select, button { font-family: 'Inter', system-ui, sans-serif; font-size: 15px; }
  button { cursor: pointer; }
  input:focus, select:focus, button:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

  .wrap { max-width: 920px; margin: 0 auto; }

  .header {
    display: flex; justify-content: space-between; align-items: flex-end;
    margin-bottom: 20px; flex-wrap: wrap; gap: 14px;
  }
  .eyebrow { font-size: 12px; color: var(--muted); margin-bottom: 4px; letter-spacing: 0.02em; }
  h1 { margin: 0; font-size: 30px; font-weight: 600; line-height: 1.1; }

  .month-switch {
    display: flex; align-items: center; gap: 8px;
    background: var(--card); border: 1px solid var(--border); border-radius: 10px;
    padding: 6px 6px;
  }
  .month-switch button {
    border: none; background: transparent; font-size: 18px; padding: 4px 10px;
    color: var(--ink-dim); border-radius: 6px;
  }
  .month-switch button:active { background: var(--track); }
  .month-label { font-size: 14px; font-weight: 600; min-width: 130px; text-align: center; }

  .week-tabs {
    display: flex; gap: 8px; overflow-x: auto; padding: 2px 2px 10px;
    margin-bottom: 6px; -webkit-overflow-scrolling: touch;
  }
  .week-chip {
    flex-shrink: 0; font-family: 'Inter', system-ui, sans-serif; font-size: 12.5px; font-weight: 600;
    padding: 8px 14px; border-radius: 999px; border: 1px solid var(--border);
    background: var(--card); color: var(--ink-dim); white-space: nowrap;
  }
  .week-chip.active { background: var(--accent); color: #fff; border-color: var(--accent); }

  .save-banner {
    background: var(--bad-bg); border: 1px solid var(--bad-border); color: var(--bad-text);
    border-radius: 10px; padding: 10px 14px; margin-bottom: 18px; font-size: 13px;
  }

  .settings-row {
    display: flex; align-items: flex-end; gap: 16px; flex-wrap: wrap;
    margin-bottom: 20px;
  }
  .settings-field {
    display: flex; flex-direction: column; gap: 4px; font-size: 12px; color: var(--ink-dim); font-weight: 600;
  }
  .settings-field select, .settings-field input {
    padding: 8px 10px; border-radius: 8px; border: 1px solid var(--border); font-size: 14px;
    background: var(--card); color: var(--ink); min-width: 170px;
  }
  .settings-clear {
    border: none; background: none; color: var(--accent); font-size: 12px; font-weight: 600;
    padding: 8px 0; text-decoration: underline; text-underline-offset: 2px;
  }

  .overview {
    background: var(--dark); color: var(--bg); border-radius: 16px;
    padding: 22px 22px; margin-bottom: 20px;
    display: flex; justify-content: space-between; align-items: center;
    flex-wrap: wrap; gap: 18px;
  }
  .overview.over { background: var(--dark-bad); }
  .ov-amount { font-size: 30px; font-weight: 600; }
  .ov-sub { font-size: 12px; opacity: 0.65; margin-bottom: 6px; }
  .ov-of { font-size: 13px; opacity: 0.7; margin-top: 2px; }
  .ov-bar-wrap { flex: 1; min-width: 160px; max-width: 320px; }
  .ov-track { height: 8px; background: rgba(255,255,255,0.15); border-radius: 4px; overflow: hidden; }
  .ov-fill { height: 100%; transition: width 0.3s ease; background: var(--good); }
  .ov-fill.over { background: var(--bad); }
  .ov-pct { font-size: 12px; opacity: 0.7; margin-top: 6px; }
  .ov-warning {
    display: flex; align-items: center; gap: 8px;
    background: rgba(194,78,122,0.2); border: 1px solid rgba(194,78,122,0.45);
    border-radius: 10px; padding: 10px 14px; font-size: 13px; font-weight: 600;
  }

  .cat-warning {
    background: var(--bad-bg); border: 1px solid var(--bad-border); border-radius: 12px;
    padding: 14px 18px; margin-bottom: 20px;
  }
  .cat-warning-title {
    display: flex; align-items: center; gap: 8px; color: var(--bad-text);
    font-weight: 600; font-size: 14px; margin-bottom: 8px;
  }
  .cat-warning-list { display: flex; flex-wrap: wrap; gap: 6px 18px; }
  .cat-warning-list span { font-size: 13px; color: var(--bad-text); }

  .grid { display: grid; grid-template-columns: minmax(280px, 1fr) minmax(280px, 1.1fr); gap: 20px; }
  @media (max-width: 720px) { .grid { grid-template-columns: 1fr; } }

  .card { background: var(--card); border: 1px solid var(--border); border-radius: 16px; padding: 20px; }
  .card + .card { margin-top: 20px; }
  .card-title { font-size: 13px; font-weight: 600; color: var(--ink-dim); margin-bottom: 2px; }
  .card-subtitle { font-size: 11.5px; color: var(--faint); margin-bottom: 14px; }

  .chart-empty {
    height: 200px; display: flex; align-items: center; justify-content: center;
    color: var(--faint); font-size: 13px; text-align: center;
  }
  .legend { display: flex; flex-wrap: wrap; gap: 8px 16px; padding: 10px 2px 4px; }
  .legend-item { display: flex; align-items: center; gap: 6px; font-size: 12px; color: var(--ink-dim); }
  .dot { width: 8px; height: 8px; border-radius: 50%; display: inline-block; flex-shrink: 0; }

  .cat-head-row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px; }
  .add-cat-btn { border: none; background: none; color: var(--accent); font-size: 13px; font-weight: 600; display: flex; align-items: center; gap: 4px; padding: 4px 0; }

  .add-cat-form { display: flex; gap: 8px; margin-bottom: 14px; flex-wrap: wrap; }
  .add-cat-form input { flex: 1; min-width: 100px; padding: 9px 10px; border-radius: 8px; border: 1px solid var(--border); }
  .add-cat-form input.budget-input { width: 90px; flex: none; }
  .add-cat-form button { background: var(--accent); color: #fff; border: none; border-radius: 8px; padding: 9px 14px; font-weight: 600; }

  .cat-row { padding: 6px 0; }
  .cat-row-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px; gap: 8px; flex-wrap: wrap; }
  .cat-name { display: flex; align-items: center; gap: 7px; font-size: 13px; font-weight: 600; }
  .cat-meta { display: flex; align-items: center; gap: 8px; }
  .cat-spent { font-size: 12px; color: var(--muted); white-space: nowrap; }
  .cat-spent.over { color: #8A2B57; }
  .budget-edit { width: 62px; padding: 4px 6px; border-radius: 6px; border: 1px solid var(--border); font-size: 12px; text-align: right; }
  .icon-btn { border: none; background: none; color: var(--faint); padding: 4px; display: flex; align-items: center; }
  .cat-track { height: 5px; background: var(--track); border-radius: 3px; overflow: hidden; }
  .cat-fill { height: 100%; transition: width 0.2s; }

  .expense-form { display: flex; flex-direction: column; gap: 10px; }
  .expense-form select, .expense-form input { padding: 11px 12px; border-radius: 8px; border: 1px solid var(--border); width: 100%; }
  .expense-form-row { display: flex; gap: 8px; }
  .expense-form-row input:first-child { flex: 1; }
  .expense-form-row input:last-child { flex: 1.4; }
  .add-expense-btn {
    background: var(--dark); color: var(--bg); border: none; border-radius: 8px;
    padding: 13px; font-weight: 600; display: flex; align-items: center; justify-content: center; gap: 6px;
  }
  .add-expense-btn:active { opacity: 0.85; }

  .empty-state { display: flex; flex-direction: column; align-items: center; gap: 8px; padding: 30px 0; color: var(--faint); }
  .empty-state span { font-size: 13px; text-align: center; }

  .expense-list { display: flex; flex-direction: column; gap: 0; max-height: 420px; overflow-y: auto; }
  .expense-row {
    display: flex; justify-content: space-between; align-items: center;
    padding: 11px 2px; border-bottom: 1px solid var(--track); gap: 10px;
  }
  .expense-left { display: flex; align-items: center; gap: 10px; min-width: 0; }
  .expense-cat { font-size: 13.5px; font-weight: 500; }
  .expense-sub { font-size: 12px; color: var(--faint); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 200px; }
  .expense-right { display: flex; align-items: center; gap: 10px; flex-shrink: 0; }
  .expense-amt { font-size: 13.5px; font-weight: 600; }

  svg.pie { display: block; margin: 0 auto; }
</style>
</head>
<body>

<div class="wrap">
  <div class="header">
    <div>
      <div class="eyebrow sans">Ledger</div>
      <h1>Monthly Budget</h1>
    </div>
    <div class="month-switch sans">
      <button id="prevMonth" aria-label="Previous month">‹</button>
      <span class="month-label" id="monthLabel"></span>
      <button id="nextMonth" aria-label="Next month">›</button>
    </div>
  </div>

  <div class="week-tabs sans" id="weekTabs"></div>

  <div class="settings-row sans">
    <label class="settings-field">
      <span>Currency</span>
      <select id="currencySelect">
        <option value="USD">USD ($)</option>
        <option value="GBP">GBP (£)</option>
        <option value="EUR">EUR (€)</option>
        <option value="JPY">JPY (¥)</option>
        <option value="CAD">CAD (C$)</option>
        <option value="AUD">AUD (A$)</option>
        <option value="INR">INR (₹)</option>
        <option value="CHF">CHF</option>
      </select>
    </label>
    <label class="settings-field">
      <span>Total budget this month</span>
      <input type="number" id="totalBudgetOverride" min="0" step="0.01" placeholder="Auto (sum of categories)">
    </label>
    <button id="clearOverrideBtn" class="settings-clear" type="button" title="Use sum of category budgets instead">Reset to auto</button>
  </div>

  <div id="overview" class="overview">
    <div>
      <div class="ov-sub sans">Spent this month</div>
      <div class="ov-amount" id="ovAmount">$0.00</div>
      <div class="ov-of sans" id="ovOf">of $0.00 budgeted</div>
    </div>
    <div class="ov-bar-wrap">
      <div class="ov-track"><div class="ov-fill" id="ovFill" style="width:0%"></div></div>
      <div class="ov-pct sans" id="ovPct"></div>
    </div>
    <div class="ov-warning sans" id="ovWarning" style="display:none">
      ⚠ <span id="ovWarningText"></span>
    </div>
  </div>

  <div id="catWarning" class="cat-warning" style="display:none">
    <div class="cat-warning-title sans"><span>⚠</span><span id="catWarningTitle"></span></div>
    <div class="cat-warning-list sans" id="catWarningList"></div>
  </div>

  <div class="grid">
    <div>
      <div class="card">
        <div class="card-title sans" id="chartTitle">Where it's going</div>
        <div class="card-subtitle sans" id="chartSubtitle">This month</div>
        <div id="chartArea"></div>
        <div class="legend" id="legend"></div>
      </div>

      <div class="card">
        <div class="cat-head-row">
          <div>
            <div class="card-title sans" style="margin-bottom:2px">Categories & budgets</div>
            <div class="card-subtitle sans" style="margin-bottom:0" id="budgetsSubtitle">This month's targets</div>
          </div>
          <button class="add-cat-btn sans" id="toggleAddCat">+ Add category</button>
        </div>
        <form class="add-cat-form sans" id="addCatForm" style="display:none; margin-top:14px;">
          <input type="text" id="newCatName" placeholder="Category name" required>
          <input type="number" id="newCatBudget" class="budget-input" placeholder="Budget" min="0" step="0.01" required>
          <button type="submit">Add</button>
        </form>
        <div id="categoryList" style="margin-top:14px;"></div>
      </div>
    </div>

    <div>
      <div class="card">
        <div class="card-title sans" id="formTitle">Log an expense</div>
        <div class="card-subtitle sans" id="formSubtitle">This month</div>
        <form class="expense-form" id="expenseForm">
          <select id="expCategory" required></select>
          <div class="expense-form-row">
            <input type="number" id="expAmount" placeholder="Amount" min="0" step="0.01" required>
            <input type="text" id="expNote" placeholder="Note (optional)">
          </div>
          <input type="date" id="expDate" required>
          <button type="submit" class="add-expense-btn">+ Add expense</button>
        </form>
      </div>

      <div class="card">
        <div class="card-title sans" id="expenseListTitle">Expenses</div>
        <div id="expenseListArea"></div>
      </div>
    </div>
  </div>
</div>

<script>
(function() {
  'use strict';

  var STORAGE_CATEGORIES = 'budget-tracker-categories-v2';
  var STORAGE_BUDGETS_PREFIX = 'budget-tracker-budgets-';
  var STORAGE_EXPENSES_ALL = 'budget-tracker-expenses-all-v2';
  var STORAGE_EXPENSES_OLD_PREFIX = 'budget-tracker-expenses-'; // v1 per-month arrays, for migration
  var STORAGE_OLD_CATEGORIES = 'budget-tracker-categories'; // v1, had embedded budgets
  var STORAGE_CURRENCY = 'budget-tracker-currency';
  var STORAGE_OVERRIDE_PREFIX = 'budget-tracker-total-override-';

  var DEFAULT_CATEGORIES = [
    { name: 'Housing', color: '#6D4AFF' },
    { name: 'Groceries', color: '#6D6E71' },
    { name: 'Transport', color: '#9B84FF' },
    { name: 'Dining Out', color: '#A5A6A9' },
    { name: 'Utilities', color: '#4B2FBF' },
    { name: 'Fun', color: '#4A4B4E' }
  ];
  var DEFAULT_BUDGETS = { 'Housing': 1200, 'Groceries': 400, 'Transport': 200, 'Dining Out': 150, 'Utilities': 180, 'Fun': 120 };

  var PALETTE = ['#6D4AFF', '#6D6E71', '#9B84FF', '#A5A6A9', '#4B2FBF', '#4A4B4E', '#C4B8FF', '#8E8F92'];

  var state = {
    month: currentMonthKey(),
    categories: [],
    budgets: {},           // { catName: amount } for the current month
    expenses: [],          // FLAT array of ALL expenses, each with .date = 'YYYY-MM-DD'
    currency: 'USD',
    totalOverride: null,
    scope: 'month'         // 'month' or a week key 'YYYY-MM-DD' (that week's Monday)
  };

  // ---------- storage helpers ----------
  var memoryFallback = {};

  function storageGet(key) {
    try { return window.localStorage.getItem(key); }
    catch (e) { return memoryFallback[key] || null; }
  }
  function storageSet(key, value) {
    try { window.localStorage.setItem(key, value); return true; }
    catch (e) { memoryFallback[key] = value; return false; }
  }
  function storageRemove(key) {
    try { window.localStorage.removeItem(key); } catch (e) {}
  }
  function storageAllKeys() {
    try { return Object.keys(window.localStorage); } catch (e) { return Object.keys(memoryFallback); }
  }

  function showSaveBanner() {
    if (document.getElementById('saveBanner')) return;
    var wrap = document.querySelector('.wrap');
    var banner = document.createElement('div');
    banner.id = 'saveBanner';
    banner.className = 'save-banner sans';
    banner.textContent = "Your browser is blocking saved storage, so changes won't persist after you close this page.";
    wrap.insertBefore(banner, wrap.children[1]);
  }

  // ---------- date helpers ----------
  function pad2(n) { return String(n).padStart(2, '0'); }

  function toDateStr(d) { return d.getFullYear() + '-' + pad2(d.getMonth() + 1) + '-' + pad2(d.getDate()); }

  function parseDateStr(s) {
    var parts = s.split('-').map(Number);
    return new Date(parts[0], parts[1] - 1, parts[2]);
  }

  function currentMonthKey() {
    var d = new Date();
    return d.getFullYear() + '-' + pad2(d.getMonth() + 1);
  }

  function todayStr() { return toDateStr(new Date()); }

  function monthKeyOfDateStr(dateStr) { return dateStr.slice(0, 7); }

  function monthLabel(key) {
    var parts = key.split('-').map(Number);
    var d = new Date(parts[0], parts[1] - 1, 1);
    return d.toLocaleString('en-US', { month: 'long', year: 'numeric' });
  }

  function shiftMonthKey(key, delta) {
    var parts = key.split('-').map(Number);
    var d = new Date(parts[0], parts[1] - 1 + delta, 1);
    return d.getFullYear() + '-' + pad2(d.getMonth() + 1);
  }

  function shortDate(d) {
    return d.toLocaleString('en-US', { month: 'short', day: 'numeric' });
  }

  // Monday-start week containing d
  function weekStartOf(d) {
    var day = d.getDay(); // 0 = Sun
    var diff = (day === 0) ? -6 : 1 - day;
    var monday = new Date(d.getFullYear(), d.getMonth(), d.getDate() + diff);
    return monday;
  }

  function weeksOverlappingMonth(monthKey) {
    var parts = monthKey.split('-').map(Number);
    var firstOfMonth = new Date(parts[0], parts[1] - 1, 1);
    var lastOfMonth = new Date(parts[0], parts[1], 0);
    var weeks = [];
    var cursor = weekStartOf(firstOfMonth);
    while (cursor <= lastOfMonth) {
      var end = new Date(cursor.getFullYear(), cursor.getMonth(), cursor.getDate() + 6);
      weeks.push({
        key: toDateStr(cursor),
        start: new Date(cursor),
        end: end,
        label: shortDate(cursor) + ' – ' + shortDate(end)
      });
      cursor = new Date(cursor.getFullYear(), cursor.getMonth(), cursor.getDate() + 7);
    }
    return weeks;
  }

  function fmt(n) {
    var currency = state.currency || 'USD';
    try {
      return Number(n).toLocaleString('en-US', { style: 'currency', currency: currency, maximumFractionDigits: 2 });
    } catch (e) {
      return Number(n).toFixed(2) + ' ' + currency;
    }
  }

  function escapeHtml(str) {
    var div = document.createElement('div');
    div.textContent = str;
    return div.innerHTML;
  }

  // ---------- migration from v1 ----------
  function migrateIfNeeded() {
    // Expenses: merge any old per-month arrays into the new flat store
    if (storageGet(STORAGE_EXPENSES_ALL) === null) {
      var merged = [];
      storageAllKeys().forEach(function(k) {
        if (k.indexOf(STORAGE_EXPENSES_OLD_PREFIX) === 0) {
          try {
            var arr = JSON.parse(storageGet(k)) || [];
            arr.forEach(function(e) {
              var dateStr = e.date ? e.date.slice(0, 10) : todayStr();
              merged.push({ id: e.id, category: e.category, amount: e.amount, note: e.note || '', date: dateStr });
            });
          } catch (err) { /* ignore malformed */ }
        }
      });
      storageSet(STORAGE_EXPENSES_ALL, JSON.stringify(merged));
    }

    // Categories + budgets: if old single-list-with-embedded-budget format exists, split it out
    if (storageGet(STORAGE_CATEGORIES) === null) {
      var oldCatsRaw = storageGet(STORAGE_OLD_CATEGORIES);
      if (oldCatsRaw) {
        try {
          var oldCats = JSON.parse(oldCatsRaw);
          var newCats = oldCats.map(function(c) { return { name: c.name, color: c.color }; });
          storageSet(STORAGE_CATEGORIES, JSON.stringify(newCats));
          // seed current month's budgets from the old flat structure if not already present
          var seedBudgets = {};
          oldCats.forEach(function(c) { seedBudgets[c.name] = c.budget; });
          if (storageGet(STORAGE_BUDGETS_PREFIX + currentMonthKey()) === null) {
            storageSet(STORAGE_BUDGETS_PREFIX + currentMonthKey(), JSON.stringify(seedBudgets));
          }
        } catch (err) { /* ignore */ }
      }
    }
  }

  // ---------- load / save: categories ----------
  function loadCategories() {
    var raw = storageGet(STORAGE_CATEGORIES);
    if (raw) { try { return JSON.parse(raw); } catch (e) {} }
    return DEFAULT_CATEGORIES.slice();
  }
  function saveCategories() {
    var ok = storageSet(STORAGE_CATEGORIES, JSON.stringify(state.categories));
    if (!ok) showSaveBanner();
  }

  // ---------- load / save: budgets (per month, with carry-over) ----------
  function loadBudgetsForMonth(monthKey) {
    var raw = storageGet(STORAGE_BUDGETS_PREFIX + monthKey);
    if (raw) { try { return JSON.parse(raw); } catch (e) {} }

    // search backward for nearest previous month with saved budgets
    var searchKey = monthKey;
    for (var i = 0; i < 60; i++) {
      searchKey = shiftMonthKey(searchKey, -1);
      var prevRaw = storageGet(STORAGE_BUDGETS_PREFIX + searchKey);
      if (prevRaw) {
        try {
          var carried = JSON.parse(prevRaw);
          storageSet(STORAGE_BUDGETS_PREFIX + monthKey, JSON.stringify(carried));
          return carried;
        } catch (e) { break; }
      }
    }

    // nothing found anywhere: fall back to defaults for known categories, 0 for custom ones
    var fallback = {};
    state.categories.forEach(function(c) {
      fallback[c.name] = DEFAULT_BUDGETS.hasOwnProperty(c.name) ? DEFAULT_BUDGETS[c.name] : 0;
    });
    storageSet(STORAGE_BUDGETS_PREFIX + monthKey, JSON.stringify(fallback));
    return fallback;
  }

  function saveBudgetsForMonth() {
    var ok = storageSet(STORAGE_BUDGETS_PREFIX + state.month, JSON.stringify(state.budgets));
    if (!ok) showSaveBanner();
  }

  // ---------- load / save: expenses (flat) ----------
  function loadAllExpenses() {
    var raw = storageGet(STORAGE_EXPENSES_ALL);
    if (raw) { try { return JSON.parse(raw); } catch (e) {} }
    return [];
  }
  function saveAllExpenses() {
    var ok = storageSet(STORAGE_EXPENSES_ALL, JSON.stringify(state.expenses));
    if (!ok) showSaveBanner();
  }

  // ---------- load / save: currency & override ----------
  function loadCurrency() { return storageGet(STORAGE_CURRENCY) || 'USD'; }
  function saveCurrency() { if (!storageSet(STORAGE_CURRENCY, state.currency)) showSaveBanner(); }

  function loadTotalOverride(month) {
    var raw = storageGet(STORAGE_OVERRIDE_PREFIX + month);
    if (raw === null || raw === '') return null;
    var v = parseFloat(raw);
    return isNaN(v) ? null : v;
  }
  function saveTotalOverride() {
    var key = STORAGE_OVERRIDE_PREFIX + state.month;
    var ok;
    if (state.totalOverride === null) { storageRemove(key); ok = true; }
    else { ok = storageSet(key, String(state.totalOverride)); }
    if (!ok) showSaveBanner();
  }

  // ---------- derived data ----------
  function expensesForMonth(monthKey) {
    return state.expenses.filter(function(e) { return monthKeyOfDateStr(e.date) === monthKey; });
  }

  function expensesForWeek(weekKey) {
    var start = parseDateStr(weekKey);
    var end = new Date(start.getFullYear(), start.getMonth(), start.getDate() + 6);
    return state.expenses.filter(function(e) {
      var d = parseDateStr(e.date);
      return d >= start && d <= end;
    });
  }

  function currentScopeExpenses() {
    return state.scope === 'month' ? expensesForMonth(state.month) : expensesForWeek(state.scope);
  }

  function spentByCategory(list) {
    var map = {};
    state.categories.forEach(function(c) { map[c.name] = 0; });
    list.forEach(function(e) { map[e.category] = (map[e.category] || 0) + Number(e.amount); });
    return map;
  }

  function totalBudget() {
    if (state.totalOverride !== null && state.totalOverride !== undefined) return state.totalOverride;
    return state.categories.reduce(function(s, c) { return s + Number(state.budgets[c.name] || 0); }, 0);
  }

  function totalSpentMonth() {
    return expensesForMonth(state.month).reduce(function(s, e) { return s + Number(e.amount); }, 0);
  }

  // ---------- pie chart (pure SVG) ----------
  function renderPieChart(data) {
    var area = document.getElementById('chartArea');
    var total = data.reduce(function(s, d) { return s + d.value; }, 0);
    if (total <= 0) {
      area.innerHTML = '<div class="chart-empty sans">No expenses logged yet for this view</div>';
      return;
    }
    var size = 220, cx = size / 2, cy = size / 2, rOuter = 95, rInner = 55;
    var startAngle = -90, paths = '';
    data.forEach(function(d) {
      var angle = (d.value / total) * 360;
      var endAngle = startAngle + angle;
      paths += arcPath(cx, cy, rOuter, rInner, startAngle, endAngle, d.color);
      startAngle = endAngle;
    });
    area.innerHTML = '<svg class="pie" width="' + size + '" height="' + size + '" viewBox="0 0 ' + size + ' ' + size + '">' + paths + '</svg>';
  }

  function polarToCartesian(cx, cy, r, angleDeg) {
    var rad = angleDeg * Math.PI / 180;
    return { x: cx + r * Math.cos(rad), y: cy + r * Math.sin(rad) };
  }

  function arcPath(cx, cy, rOuter, rInner, startAngle, endAngle, color) {
    var gap = 1.2;
    var sa = startAngle + gap / 2, ea = endAngle - gap / 2;
    if (ea <= sa) ea = sa + 0.01;
    var p1 = polarToCartesian(cx, cy, rOuter, sa);
    var p2 = polarToCartesian(cx, cy, rOuter, ea);
    var p3 = polarToCartesian(cx, cy, rInner, ea);
    var p4 = polarToCartesian(cx, cy, rInner, sa);
    var largeArc = (ea - sa) > 180 ? 1 : 0;
    var d = ['M', p1.x, p1.y, 'A', rOuter, rOuter, 0, largeArc, 1, p2.x, p2.y,
             'L', p3.x, p3.y, 'A', rInner, rInner, 0, largeArc, 0, p4.x, p4.y, 'Z'].join(' ');
    return '<path d="' + d + '" fill="' + color + '"></path>';
  }

  // ---------- week tabs ----------
  function renderWeekTabs() {
    var weeks = weeksOverlappingMonth(state.month);
    var html = '<button class="week-chip' + (state.scope === 'month' ? ' active' : '') + '" data-scope="month">Whole month</button>';
    weeks.forEach(function(w) {
      html += '<button class="week-chip' + (state.scope === w.key ? ' active' : '') + '" data-scope="' + w.key + '">' + escapeHtml(w.label) + '</button>';
    });
    document.getElementById('weekTabs').innerHTML = html;
    document.querySelectorAll('.week-chip').forEach(function(btn) {
      btn.onclick = function() {
        state.scope = btn.getAttribute('data-scope');
        render();
      };
    });
  }

  function scopeLabel() {
    if (state.scope === 'month') return 'This month';
    var weeks = weeksOverlappingMonth(state.month);
    var w = weeks.find(function(w) { return w.key === state.scope; });
    return w ? ('Week of ' + w.label) : 'This week';
  }

  function defaultDateForScope() {
    if (state.scope === 'month') {
      var todayInMonth = monthKeyOfDateStr(todayStr()) === state.month;
      if (todayInMonth) return todayStr();
      var parts = state.month.split('-').map(Number);
      return toDateStr(new Date(parts[0], parts[1] - 1, 1));
    } else {
      var start = parseDateStr(state.scope);
      var end = new Date(start.getFullYear(), start.getMonth(), start.getDate() + 6);
      var today = new Date();
      if (today >= start && today <= end) return todayStr();
      return state.scope;
    }
  }

  // ---------- render ----------
  function render() {
    document.getElementById('monthLabel').textContent = monthLabel(state.month);

    var currencySelectEl = document.getElementById('currencySelect');
    if (currencySelectEl.value !== state.currency) currencySelectEl.value = state.currency;

    var overrideInputEl = document.getElementById('totalBudgetOverride');
    if (document.activeElement !== overrideInputEl) {
      overrideInputEl.value = (state.totalOverride === null || state.totalOverride === undefined) ? '' : state.totalOverride;
    }

    renderWeekTabs();

    // ---- monthly overview (always whole-month, regardless of scope) ----
    var monthExpenses = expensesForMonth(state.month);
    var spentMonth = spentByCategory(monthExpenses);
    var tBudget = totalBudget();
    var tSpent = totalSpentMonth();
    var isOverTotal = tSpent > tBudget && tBudget > 0;
    var pct = tBudget > 0 ? Math.min(100, (tSpent / tBudget) * 100) : 0;

    var overviewEl = document.getElementById('overview');
    overviewEl.className = 'overview' + (isOverTotal ? ' over' : '');
    document.getElementById('ovAmount').textContent = fmt(tSpent);
    var overrideActive = state.totalOverride !== null && state.totalOverride !== undefined;
    document.getElementById('ovOf').textContent = 'of ' + fmt(tBudget) + ' budgeted' + (overrideActive ? ' (manual)' : '');
    var fillEl = document.getElementById('ovFill');
    fillEl.style.width = pct + '%';
    fillEl.className = 'ov-fill' + (isOverTotal ? ' over' : '');
    document.getElementById('ovPct').textContent = tBudget > 0 ? (pct.toFixed(0) + '% of total budget used') : 'Set category budgets to track progress';

    var warnEl = document.getElementById('ovWarning');
    if (isOverTotal) {
      warnEl.style.display = 'flex';
      document.getElementById('ovWarningText').textContent = 'Over budget by ' + fmt(tSpent - tBudget);
    } else {
      warnEl.style.display = 'none';
    }

    var overCats = state.categories.filter(function(c) { return spentMonth[c.name] > (state.budgets[c.name] || 0); });
    var catWarnEl = document.getElementById('catWarning');
    if (overCats.length > 0) {
      catWarnEl.style.display = 'block';
      document.getElementById('catWarningTitle').textContent =
        (overCats.length === 1 ? '1 category is' : overCats.length + ' categories are') + ' over its monthly budget';
      document.getElementById('catWarningList').innerHTML = overCats.map(function(c) {
        return '<span>' + escapeHtml(c.name) + ': ' + fmt(spentMonth[c.name]) + ' / ' + fmt(state.budgets[c.name] || 0) + '</span>';
      }).join('');
    } else {
      catWarnEl.style.display = 'none';
    }

    // ---- categories & budgets card (always month-level targets) ----
    document.getElementById('budgetsSubtitle').textContent = monthLabel(state.month) + "'s targets";
    var catListEl = document.getElementById('categoryList');
    catListEl.innerHTML = state.categories.map(function(c) {
      var budget = state.budgets[c.name] || 0;
      var s = spentMonth[c.name] || 0;
      var over = s > budget;
      var catPct = budget > 0 ? Math.min(100, (s / budget) * 100) : 0;
      return (
        '<div class="cat-row" data-cat="' + escapeHtml(c.name) + '">' +
          '<div class="cat-row-top">' +
            '<div class="cat-name sans"><span class="dot" style="background:' + c.color + '"></span>' + escapeHtml(c.name) + '</div>' +
            '<div class="cat-meta sans">' +
              '<span class="cat-spent' + (over ? ' over' : '') + '">' + fmt(s) + ' / </span>' +
              '<input type="number" min="0" step="0.01" class="budget-edit" value="' + budget + '" data-role="budget-input" data-cat="' + escapeHtml(c.name) + '">' +
              '<button class="icon-btn" data-role="remove-cat" data-cat="' + escapeHtml(c.name) + '" aria-label="Remove ' + escapeHtml(c.name) + '">✕</button>' +
            '</div>' +
          '</div>' +
          '<div class="cat-track"><div class="cat-fill" style="width:' + catPct + '%;background:' + (over ? '#C24E7A' : c.color) + '"></div></div>' +
        '</div>'
      );
    }).join('');

    // ---- scoped view: chart, expense form, expense list ----
    var scopeExpenses = currentScopeExpenses();
    var spentScope = spentByCategory(scopeExpenses);
    var label = scopeLabel();

    document.getElementById('chartSubtitle').textContent = label;
    document.getElementById('formSubtitle').textContent = label;

    var pieData = state.categories
      .map(function(c) { return { name: c.name, value: spentScope[c.name] || 0, color: c.color }; })
      .filter(function(d) { return d.value > 0; });
    renderPieChart(pieData);
    document.getElementById('legend').innerHTML = pieData.map(function(d) {
      return '<div class="legend-item sans"><span class="dot" style="background:' + d.color + '"></span>' + escapeHtml(d.name) + '</div>';
    }).join('');

    var selectEl = document.getElementById('expCategory');
    var prevVal = selectEl.value;
    selectEl.innerHTML = state.categories.map(function(c) {
      return '<option value="' + escapeHtml(c.name) + '">' + escapeHtml(c.name) + '</option>';
    }).join('');
    if (state.categories.some(function(c) { return c.name === prevVal; })) selectEl.value = prevVal;

    var dateInput = document.getElementById('expDate');
    if (document.activeElement !== dateInput) dateInput.value = defaultDateForScope();

    document.getElementById('expenseListTitle').textContent = label + ' expenses (' + scopeExpenses.length + ')';
    var listArea = document.getElementById('expenseListArea');
    if (scopeExpenses.length === 0) {
      listArea.innerHTML = '<div class="empty-state sans"><span style="font-size:22px">◎</span><span>Nothing logged yet for this view — add an expense above.</span></div>';
    } else {
      var sorted = scopeExpenses.slice().sort(function(a, b) { return b.date.localeCompare(a.date); });
      listArea.innerHTML = '<div class="expense-list">' + sorted.map(function(e) {
        var cat = state.categories.find(function(c) { return c.name === e.category; });
        var color = cat ? cat.color : '#ccc';
        var dateLabel = shortDate(parseDateStr(e.date));
        var subParts = [dateLabel];
        if (e.note) subParts.push(e.note);
        return (
          '<div class="expense-row">' +
            '<div class="expense-left">' +
              '<span class="dot" style="background:' + color + '"></span>' +
              '<div>' +
                '<div class="expense-cat sans">' + escapeHtml(e.category) + '</div>' +
                '<div class="expense-sub sans">' + escapeHtml(subParts.join(' · ')) + '</div>' +
              '</div>' +
            '</div>' +
            '<div class="expense-right">' +
              '<span class="expense-amt sans">' + fmt(e.amount) + '</span>' +
              '<button class="icon-btn" data-role="delete-exp" data-id="' + e.id + '" aria-label="Delete expense">✕</button>' +
            '</div>' +
          '</div>'
        );
      }).join('') + '</div>';
    }

    bindDynamicHandlers();
  }

  function bindDynamicHandlers() {
    document.querySelectorAll('[data-role="budget-input"]').forEach(function(input) {
      input.onchange = function() {
        var name = input.getAttribute('data-cat');
        var v = parseFloat(input.value);
        state.budgets[name] = isNaN(v) ? 0 : v;
        saveBudgetsForMonth();
        render();
      };
    });

    document.querySelectorAll('[data-role="remove-cat"]').forEach(function(btn) {
      btn.onclick = function() {
        var name = btn.getAttribute('data-cat');
        state.categories = state.categories.filter(function(c) { return c.name !== name; });
        saveCategories();
        delete state.budgets[name];
        saveBudgetsForMonth();
        render();
      };
    });

    document.querySelectorAll('[data-role="delete-exp"]').forEach(function(btn) {
      btn.onclick = function() {
        var id = btn.getAttribute('data-id');
        state.expenses = state.expenses.filter(function(e) { return String(e.id) !== String(id); });
        saveAllExpenses();
        render();
      };
    });
  }

  // ---------- events ----------
  document.getElementById('currencySelect').onchange = function(ev) {
    state.currency = ev.target.value;
    saveCurrency();
    render();
  };

  document.getElementById('totalBudgetOverride').onchange = function(ev) {
    var v = parseFloat(ev.target.value);
    state.totalOverride = (ev.target.value === '' || isNaN(v)) ? null : v;
    saveTotalOverride();
    render();
  };

  document.getElementById('clearOverrideBtn').onclick = function() {
    state.totalOverride = null;
    saveTotalOverride();
    render();
  };

  document.getElementById('prevMonth').onclick = function() {
    state.month = shiftMonthKey(state.month, -1);
    state.budgets = loadBudgetsForMonth(state.month);
    state.totalOverride = loadTotalOverride(state.month);
    state.scope = 'month';
    render();
  };

  document.getElementById('nextMonth').onclick = function() {
    state.month = shiftMonthKey(state.month, 1);
    state.budgets = loadBudgetsForMonth(state.month);
    state.totalOverride = loadTotalOverride(state.month);
    state.scope = 'month';
    render();
  };

  document.getElementById('toggleAddCat').onclick = function() {
    var form = document.getElementById('addCatForm');
    form.style.display = form.style.display === 'none' ? 'flex' : 'none';
  };

  document.getElementById('addCatForm').addEventListener('submit', function(ev) {
    ev.preventDefault();
    var nameInput = document.getElementById('newCatName');
    var budgetInput = document.getElementById('newCatBudget');
    var name = nameInput.value.trim();
    var budget = parseFloat(budgetInput.value);
    if (!name || !budget || budget <= 0) return;
    if (state.categories.some(function(c) { return c.name.toLowerCase() === name.toLowerCase(); })) return;

    var color = PALETTE[state.categories.length % PALETTE.length];
    state.categories.push({ name: name, color: color });
    saveCategories();
    state.budgets[name] = budget;
    saveBudgetsForMonth();

    nameInput.value = '';
    budgetInput.value = '';
    document.getElementById('addCatForm').style.display = 'none';
    render();
  });

  document.getElementById('expenseForm').addEventListener('submit', function(ev) {
    ev.preventDefault();
    var categorySel = document.getElementById('expCategory');
    var amountInput = document.getElementById('expAmount');
    var noteInput = document.getElementById('expNote');
    var dateInput = document.getElementById('expDate');

    var amt = parseFloat(amountInput.value);
    var category = categorySel.value;
    var dateVal = dateInput.value || defaultDateForScope();
    if (!category || !amt || amt <= 0) return;

    state.expenses.unshift({
      id: Date.now() + '-' + Math.random().toString(36).slice(2, 7),
      category: category,
      amount: amt,
      note: noteInput.value.trim(),
      date: dateVal
    });
    saveAllExpenses();

    amountInput.value = '';
    noteInput.value = '';
    render();
  });

  // ---------- init ----------
  function init() {
    migrateIfNeeded();
    state.categories = loadCategories();
    state.currency = loadCurrency();
    state.budgets = loadBudgetsForMonth(state.month);
    state.totalOverride = loadTotalOverride(state.month);
    state.expenses = loadAllExpenses();
    render();
  }

  init();
})();
</script>

